<!--
  Life Insurance Application Coach
  ===================================
  Layout:
    [Breadcrumb]                         ← navigation context (custom)
    Panel: Application Progress
      [Stepper]                          ← step-by-step indicator (custom)
      [MyProgressBar]                    ← integer progress bar (custom)
    Panel: Applicant Information
      [Text: Full Name]                  ← standard
      [Text: Email]                      ← standard
      [Text: Phone]                      ← standard
      [Date Picker: Date of Birth]       ← standard
    Panel: Coverage Details
      [Single Select: Coverage Type]     ← standard
      [Decimal: Coverage Amount]         ← standard
      [Single Select: Payment Frequency] ← standard
      [Checkbox: Smoker]                 ← standard
    Panel: Actions
      [Button: Save Draft]               ← standard
      [Button: Continue]                 ← standard

  Process Variables:
    breadcrumbData   — BreadcrumbItem[]  → tw.local.breadcrumbData
    stepperData      — StepItem[]        → tw.local.stepperData
    applicationProgress — Integer        → tw.local.applicationProgress
    applicantName    — String            → tw.local.applicantName
    applicantEmail   — String            → tw.local.applicantEmail
    applicantPhone   — String            → tw.local.applicantPhone
    dateOfBirth      — Date              → tw.local.dateOfBirth
    coverageType     — String            → tw.local.coverageType
    coverageAmount   — Decimal           → tw.local.coverageAmount
    paymentFrequency — String            → tw.local.paymentFrequency
    isSmoker         — Boolean           → tw.local.isSmoker

  Sample Data (set in Coach On Load script):
    breadcrumbData   = [{label:"Home",status:"completed"},
                        {label:"Life Insurance",status:"completed"},
                        {label:"New Application",status:"working"}]
    stepperData      = [{label:"Personal Info",status:"current"},
                        {label:"Coverage",status:"pending"},
                        {label:"Medical History",status:"pending"},
                        {label:"Review & Submit",status:"pending"}]
    applicationProgress = 25
    applicantName    = "John Smith"
    applicantEmail   = "john.smith@example.com"
    applicantPhone   = "+1 (555) 234-5678"
    dateOfBirth      = 1985-06-15
    coverageType     = "Term Life"
    coverageAmount   = 500000.00
    paymentFrequency = "Monthly"
    isSmoker         = false

  Made with Bob
-->
